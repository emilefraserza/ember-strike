{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "proseWrap": "preserve",
  "printWidth": 80,
  "overrides": [
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "singleQuote": false
      }
    },
    {
      "files": [".github/workflows/*.yml", ".github/workflows/*.yaml", ".github/actions/*.yml", ".github/actions/*.yaml"],
      "options": {
        "singleQuote": false,
        "printWidth": 120
      }
    }
  ]
}